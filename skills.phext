#!/usr/bin/env python3
"""Check text against the Up Goer Five (ten hundred word) list.

Reads text from a file argument or from stdin, splits it into words on
non-letters (keeping contractions such as "can't" together), and reports
every word that is not in words.txt.

A word also passes when it is a common changed form of a listed word,
such as "uses" from "use" or "going" from "go", because the Splasho
editor treats word forms of a listed word as fine. Pass --strict to
turn that off and require the exact listed form.

Usage:
    check_ug5.py [FILE] [--words WORDS_FILE] [--suggest] [--strict]

Exit code is 0 when the text is clean, 1 when any word is flagged,
and 2 on a usage or file error.
"""

import argparse
import difflib
import re
import sys
from collections import Counter
from pathlib import Path

WORD_RE = re.compile(r"[A-Za-z]+(?:'[A-Za-z]+)?")
DEFAULT_WORDS = Path(__file__).resolve().parent.parent / "words.txt"


def normalize(word):
    """Lowercase a word and drop apostrophes and other non-letters."""
    return re.sub(r"[^a-z]", "", word.lower())


def load_words(path):
    words = set()
    for line in path.read_text(encoding="utf-8").splitlines():
        word = normalize(line)
        if word:
            words.add(word)
    return words


def stems(word):
    """Yield shorter forms of a word made by common English endings."""
    if word.endswith("'s"):
        yield word[:-2]
    if word.endswith("ies") and len(word) > 3:
        yield word[:-3] + "y"
    if word.endswith("ing") and len(word) > 4:
        yield word[:-3]
        yield word[:-3] + "e"
    if word.endswith("ed") and len(word) > 3:
        yield word[:-2]
        yield word[:-1]
    if word.endswith("es") and len(word) > 2:
        yield word[:-2]
        yield word[:-1]
    if word.endswith("s") and len(word) > 1:
        yield word[:-1]
    if word.endswith("er") and len(word) > 3:
        yield word[:-2]
        yield word[:-2] + "e"
    if word.endswith("est") and len(word) > 4:
        yield word[:-3]
        yield word[:-3] + "e"


def is_allowed(word, allowed, strict):
    if word in allowed:
        return True
    if strict:
        return False
    return any(stem in allowed for stem in stems(word))


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Check text against the Up Goer Five word list."
    )
    parser.add_argument("file", nargs="?", help="Text file to check (default: stdin)")
    parser.add_argument(
        "--words",
        type=Path,
        default=DEFAULT_WORDS,
        help="Word list file (default: words.txt beside this skill)",
    )
    parser.add_argument(
        "--suggest",
        action="store_true",
        help="Print close listed words for each flagged word",
    )
    parser.add_argument(
        "--strict",
        action="store_true",
        help="Require the exact listed form, with no changed forms allowed",
    )
    args = parser.parse_args(argv)

    try:
        allowed = load_words(args.words)
    except OSError as exc:
        print(f"error: cannot read word list {args.words}: {exc}", file=sys.stderr)
        return 2

    try:
        if args.file:
            text = Path(args.file).read_text(encoding="utf-8")
        else:
            text = sys.stdin.read()
    except OSError as exc:
        print(f"error: cannot read input: {exc}", file=sys.stderr)
        return 2

    tokens = [normalize(match) for match in WORD_RE.findall(text)]
    counts = Counter(
        token for token in tokens if token and not is_allowed(token, allowed, args.strict)
    )

    if not counts:
        print("OK: every word is on the ten hundred word list.")
        return 0

    total = sum(counts.values())
    print(f"Flagged {total} word use(s), {len(counts)} different word(s):")
    for word in sorted(counts):
        print(f"  {word} x{counts[word]}")
        if args.suggest:
            close = difflib.get_close_matches(word, sorted(allowed), n=3, cutoff=0.6)
            if close:
                print(f"    close listed words: {', '.join(close)}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
# Up Goer Five Phext Word Atlas

## Know what the atlas is

- Use this skill when the user wants a word's phext address, wants a phext address read back into nearby words, wants a text checked against the ten hundred words with coordinate-based replacement ideas, or wants to write in the atlas editor page.

- Know that every word has one natural 9 part phext address of the form a.b.c/d.e.f/g.h.i, taken from where its meaning sits in a 9 axis space fitted on a broad word sample.

- Know that address distance tracks meaning distance only roughly, with a measured correlation near 0.68, so present neighbors as neighborhood sketches and always show their distances.

- Read `~/workspace/custom-skills/upgoer-five-phext/SCHEME.md` before explaining the mapping in depth, changing the scale or center, or rebuilding the atlas.

## Address and decode words

- Run `python3 ~/workspace/custom-skills/upgoer-five-phext/address_word.py WORD` to address one or more words, and pass `--decode ADDRESS` to find the inscribed words nearest to a coordinate.

- Report a UG5 result as the word's home coordinate, and name its nearest UG5 neighbors with distances when the user wants context.

- Report a non UG5 result with its own coordinate and its nearest UG5 words, since those neighbors are the useful part of the answer.

- Report a word printed as UNEMBEDDABLE plainly as having no address in this atlas, and never invent one for it.

- Accept two names at distance 0 on a decode as a shared coordinate, since three near-identical UG5 pairs share a home.

## Validate a text

- Run `python3 ~/workspace/custom-skills/upgoer-five-phext/address_word.py --validate FILE` to flag the non UG5 words in a text and get coordinate-based replacement suggestions for each.

- Give the user the flagged words with their best few neighbors, and say plainly when a flagged word has no embedding and therefore no suggestions.

- Pair this skill with the sibling upgoer-five skill when the user wants the text actually rewritten into clean Up Goer Five, since that skill owns the translation loop and this one owns the map.

## Use and rebuild the editor

- Open `~/workspace/custom-skills/upgoer-five-phext/up-goer-five.html` for the interactive editor, which marks non UG5 words as the user types and offers neighbor replacements by coordinate distance.

- Regenerate the page after any atlas rebuild with `python3 ~/workspace/custom-skills/upgoer-five-phext/build_editor.py`, and copy it over any hosted or shared copy the user keeps.

- Edit `editor_template.html` rather than the generated page when the user wants the editor itself changed, then regenerate.

## Rebuild the atlas

- Rebuild only when the word list changes or the user asks for a fresh atlas, with `python3 ~/workspace/custom-skills/upgoer-five-phext/build_atlas.py`.

- Check the build output before trusting a rebuild, since it prints the shared coordinate pairs, the distance correlation, neighbor samples, and the atlas.phext scroll count.

- Compare the new correlation with the 0.68 recorded in SCHEME.md, and flag the rebuild if it drops in a clear way.

- Take the word list only from `~/workspace/custom-skills/upgoer-five/words.txt`, the sibling skill's copy of the ten hundred words.

## Available connectors

- Use `muse.connector_search` to find other connectors and `muse.skill_search` to find related skills.

- If nothing here fits, look on the web for a maintained API or MCP server and set it up with [Custom Connectors and MCPs](/opt/muse/skills/custom-connector-setup/SKILL.md), or build a custom connector.
name: "upgoer_five_phext"
title: "Up Goer Five Phext Word Atlas"
description: "Give any English word a phext address in a 9D atlas where the ten hundred Up Goer Five words anchor a 10x10x10 grid and distance from an anchor encodes semantic distance, or decode an address back to its anchor word and approximate semantic distance."
category: "Work and knowledge"
include_in_prompt: true
# UG5 Phext Word Atlas: Scheme Specification v2 (natural 9D positions)

## Purpose

Every word, Up Goer Five or not, gets one natural phext coordinate of
nine components in three groups of three, written a.b.c/d.e.f/g.h.i. The
coordinate is read off the word's meaning: words with close meanings get
close coordinates, and the Euclidean distance between two addresses
tracks the semantic distance between the words. There are no bins, no
cell origins, and no artificial lattice. The ten hundred UG5 words are
simply the words the atlas inscribes: they land wherever their meaning
puts them and span the space.

## The mapping

1. Embed words with GloVe 6B, 50 dimensions (cached at
   data/glove.6B.50d.txt, fetched from the stanfordnlp/glove mirror on
   Hugging Face after the Stanford host dropped the direct download).
2. Fit the axes on a broad vocabulary sample, not on the UG5 words: the
   first 60,000 entries of the GloVe file (it is frequency ordered), so
   the nine axes span general thought space. Center the sample and take
   the top 9 principal components by SVD. Each component's sign is fixed
   (largest-magnitude loading positive) so builds are reproducible.
3. Project the word onto the nine components: p_k = (v - mean) . PCk.
4. Quantize each projection with one documented center and scale, the
   same for all nine axes:

       component_k = clamp(CENTER + round(p_k / SCALE), QMIN, QMAX)
       CENTER = 150, SCALE = 0.04 GloVe units per step
       QMIN = 1, QMAX = 999

   Projection 0 (the sample mean) maps to 150 on every axis. UG5
   projections stay within about plus or minus 4.1, so UG5 coordinates
   land between 49 and 252 per axis and the clamp never binds for them.
   Extreme outlier words (projections beyond about plus or minus 5.96)
   saturate at the clamp, which is the documented price of a bounded
   coordinate range.

- Embedding lookup uses a fallback chain, identical everywhere: exact
  lowercase token, then the token with apostrophes removed, then the mean
  of the apostrophe split pieces as GloVe tokenization produces them
  ("you've" as "you" + "'ve", a word ending in "n't" as stem + "n't").
  A word with no route is unembeddable and is reported, never placed.

- Shared coordinates happen and are kept honest: at this quantization,
  997 of the 1,000 UG5 words have a unique coordinate. The three shared
  coordinates belong to near-identical pairs: it's/its, we'll/well, and
  we're/were. Co-located words share a scroll in atlas.phext and decode
  returns both names.

## Distance

- Address distance is plain Euclidean distance over the nine integer
  components. Because all axes share one scale, it is proportional to
  Euclidean distance in the 9-component projection space.

- Validation on the built atlas: over 3,999 random word pairs drawn from
  the 1,000 UG5 words plus 5,000 frequent other words, address distance
  against embedding cosine distance gives Pearson r = 0.680 and Spearman
  rho = 0.675. The 9 stored components keep global neighborhood
  structure, not fine detail: they are 9 of the 50 embedding dimensions.

- Nearest neighbors in address space are sensible for words with strong
  concrete neighborhoods and weaker for abstract or function-like words.
  Measured on the built atlas (top 5, distances in coordinate units):
  dog finds cat (26), bedroom, baby, kitchen, eat. song finds favorite,
  pop, dance, movie, music. money finds expect, raise, pay, offer, care.
  love finds movie, dream, happy, fun, girl. Weaker cases: fire finds
  train, outside, ground, along, shut; time finds made, only, one,
  another, with. Read neighbor lists as neighborhood sketches, and read
  the distances: a neighbor 60 units away is a far neighbor, whatever
  its rank.

## Decoding

- An address by itself names a point, not a word. Decoding is a nearest
  inscribed word lookup: address_word.py --decode ADDRESS prints the
  UG5 words nearest to the coordinate, with their distances. Distance 0
  means the coordinate is a word's own home (or a shared home, when two
  names print).

## Validation with neighbors

- address_word.py --validate FILE flags every word that is not a UG5
  word or a common form of one (the same word-form rules as the sibling
  upgoer-five checker), and for each flagged word prints its own natural
  coordinate plus its nearest UG5 words by address distance, with
  coordinates and distances, as replacement suggestions. A flagged word
  with no embedding is reported with no suggestions. Exit code is 1 when
  anything is flagged.

## atlas.phext: the atlas as a phext file

- atlas.phext inscribes the atlas in the delimiter format of
  libphext (see ~/workspace/phext/parse_phext.py): the scroll at
  1.1.1/1.1.1/1.1.1 is the index, listing all 1,000 UG5 words with their
  coordinates, and each inscribed coordinate carries a scroll with the
  word (or both words, for a shared coordinate) and its five nearest
  UG5 neighbors with distances.

- As built: 998 inscribed scrolls (1 index + 997 word coordinates),
  1,429,472 bytes. Most of the file is delimiter bytes (1,035,539),
  which is what sparse phext costs: reaching a coordinate near 150 on
  nine axes walks through empty scroll slots by dead reckoning. The
  file was verified with parse_phext.py, which reads back 998 non-empty
  scrolls, the index first at 1.1.1/1.1.1/1.1.1, so SQ can host it as
  it stands.

## The interactive editor

- up-goer-five.html is one self-contained page (no external assets,
  works from file://). It embeds the 1,000 UG5 words with their
  coordinates plus 5,000 frequent non-UG5 words with theirs, as inline
  JSON (page size about 292 KB).

- Features: a text editor with live marking of non-UG5 words; a chip
  list of the marked words; an inspector that shows any clicked or
  looked-up word's coordinate, grouped a.b.c/d.e.f/g.h.i, and its
  nearest UG5 neighbors by address distance (click a neighbor to put it
  in the word's place, keeping the word's capitalization); and a
  searchable index panel of all 1,000 UG5 locations. A word with no
  coordinate anywhere in the page gets spelling neighbors instead,
  labeled as spelling guesses.

- Its pure logic block (id "ug5-core" in the page) was tested headlessly
  under node 24 by extracting the block and the data: 12 checks pass,
  covering the data sizes, coordinate formatting, flagging of a sample
  sentence (rocket, enormous, engines, achieve, orbit, galaxy flagged;
  "uses" and "around" pass), inspectWord for a UG5 word, a known word
  (jazz, whose top neighbor is song), an unknown word, a clean sentence,
  and the zero distance of the co-located its/it's pair.

## Files

- coordinates.json: the 1,000 UG5 words, each with its coordinate and
  formatted address.
- data/model.json: PCA mean, nine components, quantization parameters.
- data/editor_vocab.json: coordinates for the 5,000 extra editor words.
- data/glove.6B.50d.txt: the cached embedding file (about 171 MB).
- data/query_cache.json: vectors of words address_word.py has looked
  up, so repeat queries skip the full file scan.
- atlas.phext: the inscribed atlas.
- build_atlas.py: builds the model, coordinates, editor vocab, and
  atlas.phext, and prints the validation numbers.
- editor_template.html and build_editor.py: the editor page source and
  its renderer. Run build_editor.py after build_atlas.py.
- up-goer-five.html: the rendered editor.
- address_word.py: address, decode, and validate commands.

## History

- Version 1 of this scheme binned words under UG5 anchors on a 3-plus-6
  grid. Will corrected the design on 2026-10-31: positions are natural
  and full 9D for every word, with no bins. Version 1's anchors.json and
  its quantization were removed; nothing in this version depends on
  them.
#!/usr/bin/env python3
"""Address words in the UG5 phext atlas, decode coordinates, validate text.

Every word, UG5 or not, has one natural 9D phext address: its GloVe
embedding projected onto the atlas's nine principal components and
quantized (see SCHEME.md).

Usage:
  python3 address_word.py WORD [WORD ...]
      Print each word's natural address. UG5 words also print their
      nearest UG5 neighbors in address space. Words with no GloVe route
      are reported as unembeddable and never silently placed.
  python3 address_word.py --decode a.b.c/d.e.f/g.h.i
      Print the inscribed (UG5) words nearest to the coordinate.
  python3 address_word.py --validate FILE
      Flag the non-UG5 words in a text (same word-form rules as the
      sibling upgoer-five checker) and suggest the nearest UG5 words by
      address distance for each one. Use --validate - for stdin.

Requires coordinates.json and data/model.json from build_atlas.py, plus
the GloVe file cached in data/. Only numpy beyond the standard library.
"""

import argparse
import json
import re
import sys
from pathlib import Path

import numpy as np

HERE = Path(__file__).resolve().parent
GLOVE = HERE / "data" / "glove.6B.50d.txt"
CACHE = HERE / "data" / "query_cache.json"
WORDS_TXT = HERE.parent / "upgoer-five" / "words.txt"

WORD_RE = re.compile(r"[A-Za-z]+(?:'[A-Za-z]+)?")
ADDR_RE = re.compile(r"^(\d+)\.(\d+)\.(\d+)/(\d+)\.(\d+)\.(\d+)"
                     r"/(\d+)\.(\d+)\.(\d+)$")


def fmt(c):
    return (f"{c[0]}.{c[1]}.{c[2]}/{c[3]}.{c[4]}.{c[5]}"
            f"/{c[6]}.{c[7]}.{c[8]}")


def split_parts(w):
    if w.endswith("n't"):
        return [w[:-3], "n't"]
    head, _, tail = w.partition("'")
    return [head, "'" + tail]


def wanted_tokens(words):
    wanted = set()
    for w in words:
        wanted.add(w)
        if "'" in w:
            wanted.add(w.replace("'", ""))
            wanted.update(split_parts(w))
    return wanted


def scan_glove(wanted):
    found = {}
    with open(GLOVE, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            tok = line.split(" ", 1)[0]
            if tok in wanted:
                found[tok] = np.array(line.rstrip("\n").split(" ")[1:],
                                      dtype=np.float64)
                if len(found) == len(wanted):
                    break
    return found


def embed(word, glove):
    w = word.lower()
    if w in glove:
        return glove[w]
    if "'" in w:
        squashed = w.replace("'", "")
        if squashed in glove:
            return glove[squashed]
        vecs = [glove[p] for p in split_parts(w) if p in glove]
        if vecs:
            return np.mean(vecs, axis=0)
    return None


# --- sibling checker word rules (kept in step with check_ug5.py) --------

def normalize(word):
    return re.sub(r"[^a-z]", "", word.lower())


def stems(word):
    if word.endswith("'s"):
        yield word[:-2]
    if word.endswith("ies") and len(word) > 3:
        yield word[:-3] + "y"
    if word.endswith("ing") and len(word) > 4:
        yield word[:-3]
        yield word[:-3] + "e"
    if word.endswith("ed") and len(word) > 3:
        yield word[:-2]
        yield word[:-1]
    if word.endswith("es") and len(word) > 2:
        yield word[:-2]
        yield word[:-1]
    if word.endswith("s") and len(word) > 1:
        yield word[:-1]
    if word.endswith("er") and len(word) > 3:
        yield word[:-2]
        yield word[:-2] + "e"
    if word.endswith("est") and len(word) > 4:
        yield word[:-3]
        yield word[:-3] + "e"


def is_allowed(word, allowed):
    w = word.lower()
    if normalize(w) in allowed:
        return True
    return any(normalize(s) in allowed for s in stems(w))


class Atlas:
    def __init__(self):
        coords = json.loads((HERE / "coordinates.json").read_text())
        self.words = list(coords)
        self.coord = {w: coords[w]["coord"] for w in self.words}
        self.C = np.array([self.coord[w] for w in self.words],
                          dtype=np.float64)
        model = json.loads((HERE / "data" / "model.json").read_text())
        self.mean = np.array(model["mean"])
        self.pcs = np.array(model["pcs"])
        self.scale = model["scale"]
        self.center = model["center"]
        self.qmin, self.qmax = model["qmin"], model["qmax"]

    def coord_of_vec(self, vec):
        proj = (vec - self.mean) @ self.pcs.T
        q = self.center + np.round(proj / self.scale)
        return tuple(int(x) for x in np.clip(q, self.qmin, self.qmax))

    def nearest_ug5(self, coord, k=5, exclude=None):
        d = np.linalg.norm(self.C - np.array(coord, dtype=np.float64),
                           axis=1)
        out = []
        for j in np.argsort(d):
            w = self.words[j]
            if w == exclude:
                continue
            out.append((w, self.coord[w], float(d[j])))
            if len(out) == k:
                break
        return out


def load_cache():
    if CACHE.exists():
        return json.loads(CACHE.read_text())
    return {"vectors": {}, "unembeddable": []}


def embed_words(atlas, words):
    """Embed a list of words, using and updating the query cache."""
    cache = load_cache()
    vectors, missing = {}, []
    todo = []
    for w in words:
        lw = w.lower()
        if lw in cache["vectors"]:
            vectors[w] = np.array(cache["vectors"][lw])
        elif lw in cache["unembeddable"]:
            missing.append(w)
        else:
            todo.append(w)
    if todo:
        glove = scan_glove(wanted_tokens([w.lower() for w in todo]))
        for w in todo:
            vec = embed(w, glove)
            if vec is None:
                cache["unembeddable"].append(w.lower())
                missing.append(w)
            else:
                cache["vectors"][w.lower()] = vec.tolist()
                vectors[w] = vec
        CACHE.write_text(json.dumps(cache))
    return vectors, missing


def cmd_address(atlas, words):
    vectors, missing = embed_words(
        atlas, [w for w in words if w.lower() not in atlas.coord])
    status = 0
    for word in words:
        lw = word.lower()
        if lw in atlas.coord:
            near = atlas.nearest_ug5(atlas.coord[lw], exclude=lw)
            print(f"{word}: {fmt(atlas.coord[lw])} (UG5 word; nearest "
                  f"UG5 neighbors: " +
                  ", ".join(f"{w} at {d:.0f}" for w, _, d in near[:3]) +
                  ")")
        elif word in vectors:
            coord = atlas.coord_of_vec(vectors[word])
            near = atlas.nearest_ug5(coord)
            print(f"{word}: {fmt(coord)} (not UG5; nearest UG5: " +
                  ", ".join(f"{w} at {d:.0f}" for w, _, d in near[:3]) +
                  ")")
        else:
            print(f"{word}: UNEMBEDDABLE (no GloVe vector; not placed)")
            status = 1
    return status


def cmd_decode(atlas, address):
    m = ADDR_RE.match(address.strip())
    if not m:
        print(f"{address}: not a phext address")
        return 1
    coord = tuple(int(g) for g in m.groups())
    near = atlas.nearest_ug5(coord, k=5)
    exact = [w for w, _, d in near if d == 0]
    if exact:
        print(f"{address}: inscribed word(s): {', '.join(exact)}")
    for w, c, d in near:
        print(f"  {w}  {fmt(c)}  address distance {d:.1f}")
    return 0


def cmd_validate(atlas, path, k):
    text = (sys.stdin.read() if path == "-"
            else Path(path).read_text(encoding="utf-8"))
    allowed = {normalize(w) for w in
               WORDS_TXT.read_text(encoding="utf-8").split()}
    flagged = []
    for m in WORD_RE.finditer(text):
        if not is_allowed(m.group(0), allowed) \
                and m.group(0).lower() not in [f.lower() for f in flagged]:
            flagged.append(m.group(0))
    if not flagged:
        print("clean: every word is a UG5 word or a form of one")
        return 0
    vectors, missing = embed_words(atlas, flagged)
    for word in flagged:
        if word in vectors:
            coord = atlas.coord_of_vec(vectors[word])
            near = atlas.nearest_ug5(coord, k=k)
            print(f"{word}  (at {fmt(coord)}):")
            for w, c, d in near:
                print(f"    {w}  {fmt(c)}  distance {d:.1f}")
        else:
            print(f"{word}: no embedding; no neighbors to suggest")
    return 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("words", nargs="*", help="words to address")
    ap.add_argument("--decode", metavar="ADDRESS",
                    help="nearest inscribed words to a coordinate")
    ap.add_argument("--validate", metavar="FILE",
                    help="flag non-UG5 words in a text file (- for stdin)")
    ap.add_argument("--neighbors", type=int, default=5,
                    help="suggestions per flagged word in validate mode")
    args = ap.parse_args()
    atlas = Atlas()
    if args.decode:
        return cmd_decode(atlas, args.decode)
    if args.validate:
        return cmd_validate(atlas, args.validate, args.neighbors)
    if not args.words:
        ap.print_usage()
        return 2
    return cmd_address(atlas, args.words)


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env python3
"""Build the UG5 phext word atlas (natural 9D positions, v2).

Every word gets its phext coordinate from one natural mapping: GloVe 6B
50d embeddings are projected onto the top 9 principal components fitted
over a broad 60,000-word vocabulary sample, and each projection is
quantized to a phext component. There are no bins and no cell origins.
UG5 words land wherever their meaning puts them.

Outputs:
  coordinates.json     the 1,000 UG5 words with coordinate and address
  data/model.json      PCA mean/components and quantization parameters
  data/editor_vocab.json  coordinates for 5,000 frequent non-UG5 words
                       (used by the interactive editor for suggestions)
  atlas.phext          index scroll at 1.1.1/1.1.1/1.1.1 plus one scroll
                       per inscribed coordinate, in phext delimiter form

See SCHEME.md for the full specification.
Usage: python3 build_atlas.py [--words PATH] [--glove PATH]
Only numpy is required beyond the standard library.
"""

import argparse
import json
import sys
from pathlib import Path

import numpy as np

HERE = Path(__file__).resolve().parent
DEFAULT_WORDS = HERE.parent / "upgoer-five" / "words.txt"
DEFAULT_GLOVE = HERE / "data" / "glove.6B.50d.txt"

# Quantization (see SCHEME.md): component = clamp(CENTER + round(p/SCALE)).
SCALE = 0.04        # GloVe units per coordinate step, same for all 9 axes
CENTER = 150        # coordinate value of projection 0 (the sample mean)
QMIN, QMAX = 1, 999

SAMPLE_N = 60000    # broad vocabulary sample the PCA axes are fitted on
EXTRA_N = 5000      # frequent non-UG5 words shipped to the editor
SEED = 20261031

# Phext delimiter bytes by level, from parse_phext.py (libphext order):
# library, shelf, series, collection, volume, book, chapter, section, scroll
DELIMS = [0x01, 0x1F, 0x1E, 0x1D, 0x1C, 0x1A, 0x19, 0x18, 0x17]


def fmt(coord):
    c = [int(x) for x in coord]
    return (f"{c[0]}.{c[1]}.{c[2]}/{c[3]}.{c[4]}.{c[5]}"
            f"/{c[6]}.{c[7]}.{c[8]}")


def split_parts(w):
    if w.endswith("n't"):
        return [w[:-3], "n't"]
    head, _, tail = w.partition("'")
    return [head, "'" + tail]


def wanted_tokens(words):
    wanted = set()
    for w in words:
        wanted.add(w)
        if "'" in w:
            wanted.add(w.replace("'", ""))
            wanted.update(split_parts(w))
    return wanted


def embed(word, glove):
    """GloVe vector with the contraction fallback chain, else None."""
    w = word.lower()
    if w in glove:
        return glove[w]
    if "'" in w:
        squashed = w.replace("'", "")
        if squashed in glove:
            return glove[squashed]
        vecs = [glove[p] for p in split_parts(w) if p in glove]
        if vecs:
            return np.mean(vecs, axis=0)
    return None


def write_phext(path, scrolls):
    """Write {coord_tuple: text} as a phext file, dead-reckoning style.

    Scrolls are emitted in coordinate order. A delimiter byte increments
    its level and resets all lower levels to 1, so reaching a sparse
    coordinate walks through empty scroll slots, exactly as libphext
    files do. Returns the number of delimiter bytes written.
    """
    out = bytearray()
    cur = [1] * 9
    ndelim = 0
    for coord in sorted(scrolls):
        target = list(coord)
        while cur != target:
            k = next(i for i in range(9) if cur[i] != target[i])
            if target[k] < cur[k]:
                raise ValueError(f"coordinates out of order at {coord}")
            out.append(DELIMS[k])
            ndelim += 1
            cur[k] += 1
            for j in range(k + 1, 9):
                cur[j] = 1
        out += scrolls[coord].encode("utf-8")
    Path(path).write_bytes(bytes(out))
    return ndelim


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--words", default=str(DEFAULT_WORDS))
    ap.add_argument("--glove", default=str(DEFAULT_GLOVE))
    args = ap.parse_args()

    words = [w.lower() for w in
             Path(args.words).read_text(encoding="utf-8").split()]
    if len(words) != 1000 or len(set(words)) != 1000:
        sys.exit(f"word list must hold exactly 1000 unique words, "
                 f"got {len(words)}")
    ug5_set = set(words)
    wanted = wanted_tokens(words)

    # One streaming pass over GloVe: PCA sample (first SAMPLE_N parsed
    # lines, the file is frequency ordered), UG5 tokens, and the editor's
    # extra vocabulary (frequent plain alphabetic non-UG5 words).
    sample, glove, extra = [], {}, {}
    with open(args.glove, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            parts = line.rstrip("\n").split(" ")
            if len(parts) != 51:
                continue
            tok = parts[0]
            vec = np.array(parts[1:], dtype=np.float64)
            if len(sample) < SAMPLE_N:
                sample.append(vec)
            if tok in wanted:
                glove[tok] = vec
            if (len(extra) < EXTRA_N and tok.isalpha() and tok.islower()
                    and len(tok) >= 3 and tok not in ug5_set):
                extra[tok] = vec
            if (len(sample) >= SAMPLE_N and len(extra) >= EXTRA_N
                    and wanted.issubset(glove.keys())):
                break
    S = np.stack(sample)
    print(f"PCA sample: {len(S)} vectors; editor extra vocab: {len(extra)}")

    mean = S.mean(axis=0)
    _, _, vt = np.linalg.svd(S - mean, full_matrices=False)
    pcs = vt[:9].copy()
    for k in range(9):
        j = int(np.argmax(np.abs(pcs[k])))
        if pcs[k][j] < 0:
            pcs[k] = -pcs[k]

    def coord_of(vec):
        proj = (vec - mean) @ pcs.T
        q = CENTER + np.round(proj / SCALE)
        return tuple(int(x) for x in np.clip(q, QMIN, QMAX)), proj

    ug5_vecs, missing = {}, []
    for w in words:
        v = embed(w, glove)
        if v is None:
            missing.append(w)
        else:
            ug5_vecs[w] = v
    if missing:
        sys.exit(f"anchors with no GloVe route: {missing}")
    ug5_coord = {w: coord_of(ug5_vecs[w])[0] for w in words}
    extra_coord = {w: coord_of(v)[0] for w, v in extra.items()}

    by_coord = {}
    for w in words:
        by_coord.setdefault(ug5_coord[w], []).append(w)
    shared = {c: ws for c, ws in by_coord.items() if len(ws) > 1}
    print(f"UG5 coordinates: {len(by_coord)} unique for 1000 words; "
          f"{len(shared)} shared coordinates")
    for c, ws in shared.items():
        print(f"  shared {fmt(c)}: {ws}")
    allq = np.array([ug5_coord[w] for w in words])
    print(f"UG5 coordinate ranges per axis: "
          f"{list(zip(allq.min(axis=0).tolist(), allq.max(axis=0).tolist()))}")

    model = {"scale": SCALE, "center": CENTER, "qmin": QMIN, "qmax": QMAX,
             "pca_sample_size": len(S), "mean": mean.tolist(),
             "pcs": pcs.tolist()}
    (HERE / "data" / "model.json").write_text(json.dumps(model))
    coords_doc = {w: {"address": fmt(ug5_coord[w]),
                      "coord": list(ug5_coord[w])} for w in words}
    (HERE / "coordinates.json").write_text(json.dumps(coords_doc, indent=1))
    (HERE / "data" / "editor_vocab.json").write_text(
        json.dumps({w: list(c) for w, c in extra_coord.items()}))
    print("wrote data/model.json, coordinates.json, data/editor_vocab.json")

    # ---- validation: address distance vs semantic distance ------------
    pool_words = words + list(extra)
    pool_vecs = np.stack([ug5_vecs[w] if w in ug5_vecs else extra[w]
                          for w in pool_words])
    pool_coord = np.array([ug5_coord[w] if w in ug5_coord
                           else extra_coord[w] for w in pool_words],
                          dtype=np.float64)
    Vn = pool_vecs / np.linalg.norm(pool_vecs, axis=1, keepdims=True)
    rng = np.random.default_rng(SEED)
    pairs = rng.integers(0, len(pool_words), size=(4000, 2))
    cos_d, addr_d = [], []
    for i, j in pairs:
        if i == j:
            continue
        cos_d.append(1.0 - float(Vn[i] @ Vn[j]))
        addr_d.append(float(np.linalg.norm(pool_coord[i] - pool_coord[j])))
    cos_d, addr_d = np.array(cos_d), np.array(addr_d)
    pearson = float(np.corrcoef(addr_d, cos_d)[0, 1])
    spearman = float(np.corrcoef(np.argsort(np.argsort(addr_d)),
                                 np.argsort(np.argsort(cos_d)))[0, 1])
    print(f"distance validation over {len(cos_d)} pairs: "
          f"Pearson r = {pearson:.3f}, Spearman rho = {spearman:.3f}")

    # ---- validation: UG5 neighbors in address space --------------------
    C = np.array([ug5_coord[w] for w in words], dtype=np.float64)
    print("UG5 nearest neighbors in address space (top 5):")
    nn_map = {}
    for probe in words:
        i = words.index(probe)
        d = np.linalg.norm(C - C[i], axis=1)
        near = np.argsort(d)[1:6]
        nn_map[probe] = [(words[j], float(d[j])) for j in near]
    for probe in ("fire", "water", "happy", "love", "dog", "money",
                  "time", "song"):
        if probe in nn_map:
            print(f"  {probe}: " + ", ".join(
                f"{w} ({dist:.0f})" for w, dist in nn_map[probe]))

    # ---- atlas.phext ----------------------------------------------------
    scrolls = {}
    index_lines = [
        "UG5 Phext Atlas - Index",
        "The ten hundred Up Goer Five words at their natural 9D "
        "coordinates.",
        "Each word also has its own scroll at its own coordinate.",
        "Scheme: upgoer-five-phext skill, SCHEME.md.",
        "",
    ]
    for w in words:
        index_lines.append(f"{w}  {fmt(ug5_coord[w])}")
    scrolls[(1, 1, 1, 1, 1, 1, 1, 1, 1)] = "\n".join(index_lines) + "\n"
    for coord, ws in by_coord.items():
        sections = []
        for w in sorted(ws):
            lines = [w, f"coordinate: {fmt(coord)}", "",
                     "nearest UG5 neighbors by address distance:"]
            for nw, dist in nn_map[w]:
                lines.append(f"  {nw}  {fmt(ug5_coord[nw])}  {dist:.1f}")
            sections.append("\n".join(lines))
        scrolls[coord] = "\n\n".join(sections) + "\n"
    ndelim = write_phext(HERE / "atlas.phext", scrolls)
    size = (HERE / "atlas.phext").stat().st_size
    print(f"atlas.phext: {len(scrolls)} inscribed scrolls, "
          f"{ndelim} delimiter bytes, {size} bytes total")


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""Render up-goer-five.html from editor_template.html plus the atlas data.

Reads coordinates.json (UG5 words) and data/editor_vocab.json (frequent
non-UG5 words) and inlines both as JSON, so the page is one self-contained
file that works from file:// with no external assets.

Run after build_atlas.py:  python3 build_editor.py
"""

import json
from pathlib import Path

HERE = Path(__file__).resolve().parent


def main():
    coords = json.loads((HERE / "coordinates.json").read_text())
    ug5 = {w: v["coord"] for w, v in coords.items()}
    extra = json.loads((HERE / "data" / "editor_vocab.json").read_text())
    data = json.dumps({"ug5": ug5, "extra": extra}, separators=(",", ":"))
    template = (HERE / "editor_template.html").read_text(encoding="utf-8")
    if "%%DATA_JSON%%" not in template:
        raise SystemExit("template is missing the %%DATA_JSON%% placeholder")
    out = template.replace("%%DATA_JSON%%", data)
    target = HERE / "up-goer-five.html"
    target.write_text(out, encoding="utf-8")
    print(f"wrote {target} ({len(out)} bytes, {len(ug5)} UG5 words, "
          f"{len(extra)} extra words)")


if __name__ == "__main__":
    main()
# Phext Upgrade a Project

## Read the project on its contents

- Use this skill when the user hands you any repository or project and asks for a phext upgrade, a phext version, or the best way to phextize it.

- Read the code, data formats and docs before classifying anything, and ignore surface signals such as age, stars, polish or pedigree.

- Run `python3 ~/workspace/custom-skills/phext_upgrade/scripts/phext_audit.py PROJECT_DIR` to inventory what the project actually persists, then read the files the audit flags.

- Distill every claim about the project from its own definitions, formats and invariants, and label anything you could not derive that way as a hypothesis.

## Classify before you build

- Sort every persistent or structured part of the project into one of four classes, using the tests in `references/decision-matrix.md` beside this file.

- Class A is canonical phext, for text or text encodable records that have stable identity, sparse growth, per record updates and provenance value.

- Class B is a derived phext view, for data whose canonical home must stay elsewhere but that gains from being addressable, diffable or hostable as scrolls.

- Class C is bridge only, where you ship import and export between the native format and phext without changing what the project treats as truth.

- Class D is leave alone, for numeric tensors and model weights, hot inner loops, secrets, and binary media whose structure phext cannot improve.

- State the classification for the whole project in the deliverable, including the parts you refused to phextize and why, because a phext upgrade that phextizes everything has failed its first test.

## Design the coordinate map from the project

- Derive each axis from an invariant the project already has, such as a stable slot or id, an ordered sub unit, a field lane or a graph endpoint, rather than imposing an even grid.

- Keep coordinates internal to the one phext, keep every component at 1 or above, and remember the same coordinate in another phext is a different scroll.

- Model records as fine grained per field scrolls at their coordinates, and never collapse a store into one JSON or binary blob scroll.

- Put a manifest at 1.1.1/1.1.1/1.1.1 that names the format, its version, the source commit or version it was derived from, and the coordinate map itself.

- Grow by appending new volumes, books or chapters for new record kinds, so existing addresses never move when the map expands.

- Give a store or filesystem project the whole coordinate space of one phext when it qualifies, let its callers read and write scrolls directly, and reserve immutable start and end regions with an append-only write ahead log volume between them, following the single phext filesystem archetype in the decision matrix.

## Encode for a text format

- Keep native text as plain text in its scroll, since a scroll using none of the structure is still plain text.

- Encode integer sequences as comma separated decimal text, and encode unavoidable binary as base64 text, noting that an xz seal repays most of the base64 expansion at storage and transport time.

- Design for abundance and judge the map on access patterns, invariants and complexity, not on byte count, and treat compression as a seal you apply for transport rather than the working format.

- Check that the finished phext is valid UTF-8 as a whole byte stream and that your writer agrees with a delimiter walk parser such as `~/workspace/phext/parse_phext.py`.

## Build it as a parallel adapter

- Add a new phext module beside the native persistence code and keep the native format, its API and its tests working unchanged.

- Match the native save and load API so callers can swap formats by path or flag, and add a small command line route for import and export between the two.

- Make the common mutations cheap in phext terms, so an append adds one scroll and updates a count scroll instead of rewriting the store, and a field edit touches one coordinate.

- Host or select through SQ when the project can use it, starting SQ with `~/workspace/phext/sq-ensure.sh` when it is not running, and page data in one scroll at a time where the native format forced a full scan.

- Link the new capability from the surface its audience actually lands on, such as the project README or main UI, in the same change, and write a PHEXT.md at the project root that carries the classification, the coordinate map, the measured costs and the honest limits.

## Verify the upgrade

- Prove a lossless roundtrip in both directions, phext to native and native to phext, with byte identity on the native side where the native format is deterministic.

- Cover the edge cases the project itself defines, such as empty records, empty sub units, rewritten records with advanced version counters, self references, and the project maximum record count.

- Run a mutation control and confirm that changing one record changes exactly the scrolls at its coordinates and nothing else.

- Record SHA-256 hashes for the artifacts you ship, check execute bits on scripts as well as content, and report measured size differences between the phext and the native format on a named corpus.

- Publish any reusable tooling you built in the same session under the standing publishing rules, and keep the upstream project untouched until the user directs an upstream contribution.

## The long-form process (Will, 2026-11-05)

A phext upgrade of a living project runs in four beats, in this order. Do not compress them.

- **Iterate until we actually understand the problem.** Build in phases behind flags or dual paths, run the thing, let contact with the real system correct the design — wrong seams, wrong defaults, wrong invariants all surface here. This phase is supposed to be messy and many-committed; its output is understanding, not the final shape.

- **Then squash.** Once the end state is understood and verified, collapse the whole divergence into ONE commit. Reviewability lives in the written record (below), not in the archaeology of the commit graph.

- **Then rebase and update priors.** Rebase the single commit onto upstream's current HEAD. Upstream moved while we iterated: reconcile every divergent path against what upstream actually did, adopt their improvements, and fix any of our assumptions their movement falsified. Regenerate lockfiles rather than merging them.

- **Then summarize everything in a project-helpful way.** The project's PATCHES.md (or its equivalent record) ends carrying the ENTIRE development history of the upgrade — how the final mechanism works, and details about each changed file: what changed in it and why that change is necessary. A future reader must be able to reconstruct the reasoning without the commit history, because the commit history is one commit.

## Available connectors

- [Github](~/workspace/custom-connectors/custom.github/CONNECTOR.md) for reading a public or granted repository and for the API publish route when the user directs a contribution.

- Use `muse.connector_search` to find other connectors and `muse.skill_search` to find related skills.

- If nothing here fits, look on the web for a maintained API or MCP server and set it up with [Custom Connectors and MCPs](/opt/muse/skills/custom-connector-setup/SKILL.md), or build a custom connector.

## Alternatives for better results

- Phextize only the docs and knowledge layer when the data layer fails the classification tests, since a system prompt, a runbook or an eval corpus at coordinates is still a real upgrade.

- Ship bridge only as a first phase when the project has users on its native format, and promote phext to canonical only after the roundtrip receipts exist.

- Worked example to imitate: the qwenFS upgrade at `~/workspace/qwenfs-upgrade/repo/PHEXT.md`, where the disk image went canonical phext and the constructed model weights stayed Class D.
name: "phext_upgrade"
title: "Phext Upgrade a Project"
description: "Assess any project from its own contents, decide which parts gain from phext and which must stay as they are, and ship a verified phext adapter with a coordinate map."
category: "Work and knowledge"
include_in_prompt: true
# Phext upgrade decision matrix

Distilled from phext's definition, not from analogy. Phext is an interoperable
encoding layer: characters at 9D addresses (Library.Shelf.Series /
Collection.Volume.Book / Chapter.Section.Scroll), each scroll normal 2D text,
delimiters are ASCII control bytes (themselves valid UTF-8), coordinates are
1-based, internal to one phext, and most of the space stays empty as room to
grow. Delimiter bytes, highest to lowest: 0x01, 0x1F, 0x1E, 0x1D, 0x1C, 0x1A,
0x19, 0x18, 0x17.

## The five classification tests

Apply to each persistent or structured part of the project. A part is a strong
Class A (canonical phext) candidate when the yes answers cluster; a single
hard no from tests 4 or 5 can demote it to B, C or D.

1. **Text test** — Is the content text, or losslessly text-encodable without
   changing its meaning (integer sequences as decimal, small binaries as
   base64)? Weights/tensors fail: their meaning is their exact numeric bit
   pattern at scale, text encoding multiplies size and buys no addressability
   anyone will use.
2. **Identity test** — Do records have stable identity that survives edits
   (a slot, id, path, key)? Phext addresses are stable places; data whose
   identity is "row N in a file that gets rewritten" must gain a stable key
   first, or stay a bridge.
3. **Granularity test** — Do updates touch one record or field at a time?
   Per-field scrolls pay off exactly when mutations are local. Whole-blob
   rewrites on every change gain little beyond readability (still possibly B).
4. **Access test** — Would a reader ever want one record, one segment or one
   field without scanning the whole store? If the only access pattern is
   "load everything, in order, always", phext's win is diffability and
   provenance, not paging — say so honestly.
5. **Provenance test** — Does knowing who/what/when per record, or reviewing
   changes as text diffs, matter to this project? Phext in git, or hosted in
   SQ, makes every scroll individually selectable and auditable.

## Class summary

| Class | Meaning | Examples |
|---|---|---|
| A canonical | Phext is the store of record; native tools read/write scrolls | qwenFS disk image (segments per file), ranch admin records, journals, mailboxes |
| B derived view | Canonical data stays put; a phext materialization is rebuilt from it | Search indexes, catalogs, eval corpora generated from runs, docs assembled from code |
| C bridge only | Import/export both ways, verified byte-exact on the native side | Formats with external users, fixtures other tools consume, legacy migrations |
| D leave alone | No phext representation | Model weights and tensors, crypto material and secrets, hot-loop buffers, media binaries (embed as base64 only when a one-file corpus is the explicit goal, and note the xz-seal repayment) |

## Coordinate archetypes

Derive axes from the project's own invariants. Four recurring shapes:

- **Record store** — Book = stable record slot, Chapter = record part or
  revision, Section = field lane, Scroll = field value or value chunk.
  (Bickford Llama Ranch admin pattern: one SQ update per field edit.)
- **Segmented sequence** — Book = sequence/file, Chapter = segment in order,
  Section = lane (content, metadata, ack), Scroll = chunk within a segment.
  Version/base counters live in metadata scrolls so invalidation logic can
  key on them exactly as the native format did. (qwenFS pattern.)
- **Graph** — Volume = graph, Book = source node slot, Chapter = target node
  slot, presence scroll = edge. Unlink deletes one scroll. Derived reverse
  index (backlinks) is Class B, rebuilt, never stored twice as truth.
- **Corpus / library** — Volume = work or run, Book = part, Chapter =
  chapter, Section/Scroll = passage. Manifest at 1.1.1/1.1.1/1.1.1, table of
  contents as a scroll, provenance (source, hash, date) per volume.
- **Single-phext filesystem with WAL bookends** — when the project is itself
  a store or filesystem, give the whole coordinate space to one phext and let
  the caller (often an LLM) read and write scrolls directly, with no per
  record files beside it. Reserve an immutable start volume (manifest and
  genesis, written once at format) and an immutable end volume (checkpoint
  and a seal hash over all preceding bytes), put the data in a middle volume,
  and put an append-only hash-chained write-ahead log in its own volume:
  every mutation lands in the WAL first, then applies to the store, and open
  replays or truncates a torn WAL tail and verifies both bookends. Callers
  never write the start, WAL or seal volumes directly. (qwenFS variant
  pattern.)

## Encoding rules

- Text stays text. Integer sequences: comma-separated decimal (legible,
  diffable). Floats: only when the project already treats them as text with
  a stated precision — otherwise the data is probably Class D.
- Binary that must ride inside a scroll: base64 text. Measured on a mixed
  corpus (2026-11-04, mutable.phext.io analysis): after an xz-6 seal the
  residual cost of base64 was +1.69% corpus-wide, about 95% repaid, because
  base64 carries 6 bits per byte and the compressor reclaims the expansion.
- Never write raw non-UTF-8 bytes into a phext. A conforming phext is valid
  UTF-8 as a whole byte stream.
- No JSON blob scrolls. If a scroll's content needs a parser to find the
  field you want, the fields wanted their own coordinates.

## Verification minimum

Roundtrip both directions, byte identity on the deterministic native side,
edge cases from the project's own limits (empty, max count, self reference,
rewrite/version advance), one mutation control (one record changes, exactly
its scrolls change), SHA-256 on shipped artifacts, execute bits checked as
tree modes not just hashes, and a delimiter-walk cross-parse with an
independent parser (~/workspace/phext/parse_phext.py) plus a strict UTF-8
decode of the whole file.
#!/usr/bin/env python3
"""Inventory a project's persistent/structured parts for a phext upgrade.

Usage: phext_audit.py PROJECT_DIR [--json]

Walks the tree (skipping .git, venvs, caches, node_modules), groups files by
extension with sizes, and flags candidate artifacts for classification:
structured text stores, databases, custom binary formats, docs corpora,
config, and media/weights that are usually Class D. Prints a worksheet the
agent fills in from reading the code -- this script classifies nothing by
itself, on purpose: classification must be distilled from the project's own
invariants, not from file extensions.
"""
import json
import os
import sys
from collections import defaultdict

SKIP_DIRS = {".git", ".venv", "venv", "node_modules", "__pycache__", ".tox", "dist", "build"}
FLAG_RULES = [
    ("structured-text store candidate (Class A/B test)", {".json", ".jsonl", ".csv", ".tsv", ".yaml", ".yml", ".toml", ".xml", ".phext"}),
    ("database candidate (unravel: authored vs derived)", {".db", ".sqlite", ".sqlite3"}),
    ("docs / knowledge corpus candidate (Class A/B test)", {".md", ".rst", ".txt"}),
    ("config candidate (usually bridge or leave)", {".ini", ".cfg", ".env"}),
    ("binary / weights / media (Class D test first)", {".bin", ".safetensors", ".gguf", ".npy", ".npz", ".pt", ".pth", ".onnx", ".png", ".jpg", ".gif", ".mp4", ".wav", ".mp3"}),
]


def main() -> int:
    args = [a for a in sys.argv[1:] if a != "--json"]
    as_json = "--json" in sys.argv
    if len(args) != 1:
        print(__doc__.strip().splitlines()[3], file=sys.stderr)
        return 2
    root = args[0]
    by_ext = defaultdict(lambda: [0, 0])  # ext -> [count, bytes]
    flagged = defaultdict(list)
    total_files = 0
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        for name in filenames:
            path = os.path.join(dirpath, name)
            try:
                size = os.path.getsize(path)
            except OSError:
                continue
            total_files += 1
            ext = os.path.splitext(name)[1].lower() or "(none)"
            by_ext[ext][0] += 1
            by_ext[ext][1] += size
            rel = os.path.relpath(path, root)
            for label, exts in FLAG_RULES:
                if ext in exts:
                    flagged[label].append((rel, size))
    if as_json:
        print(json.dumps({
            "root": root, "total_files": total_files,
            "by_extension": {e: {"count": c, "bytes": b} for e, (c, b) in sorted(by_ext.items())},
            "flagged": {k: v for k, v in flagged.items()},
        }, indent=1))
        return 0
    print(f"phext audit: {root}  ({total_files} files)")
    print("\nby extension (count, bytes):")
    for ext, (count, size) in sorted(by_ext.items(), key=lambda kv: -kv[1][1]):
        print(f"  {ext:14s} {count:5d}  {size:10d}")
    for label, items in flagged.items():
        print(f"\n{label}: {len(items)}")
        for rel, size in sorted(items, key=lambda t: -t[1])[:20]:
            print(f"  {size:10d}  {rel}")
    print("\nworksheet: for each flagged artifact and each custom format in code,")
    print("record in PHEXT.md: native invariants / class A-D / coordinate axis it would supply.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
# Phext-Native Dispatch

## Select the scrolls

- Run `/home/hatch/workspace/phext/phext_dispatch.py` on the source phext whenever a brief, a state file, or a result the worker must read lives in a `.phext` file.

- Select with `--coord` for exact scrolls, `--prefix` for a coordinate subtree, or `--all` only when the whole file is genuinely the input.

- Set `--page-scrolls` and `--page-chars` so each page fits the worker context, and pass the rendered dispatch file to the worker instead of pasting prose about the phext.

- Keep the provenance header the tool writes, since it carries the source path, the SHA-256, the scroll count, and the timestamp that let a result be checked against the exact input.

## Build the brief around coordinates

- Name the task, the constraints, and the expected receipts in the brief, and refer to input material by its coordinate from the dispatch index rather than by a heading or a literal marker string.

- Ask the worker to answer by coordinate as well, so its claims can be traced back to the scroll they came from.

- Never instruct a worker to search a phext-backed file as flat text for a literal marker, because phext content is addressed by coordinate and a missing marker string proves nothing about the scrolls.

- Pull only the scrolls the task needs when the source is large, instead of ingesting the whole file into the worker context.

## Check what comes back

- Verify a decisive claim by re-running the selection for its coordinate and reading that scroll, rather than trusting the worker summary.

- Treat two worker reports that conflict about the same phext as a signal to read the scroll itself, and surface the conflict instead of repeating either report.

- Report a selection that returns no scroll at a coordinate as an empty result at that coordinate, not as proof the underlying work failed or never happened.

## Available connectors

- Use `muse.connector_search` to find other connectors and `muse.skill_search` to find related skills.

- If nothing here fits, look on the web for a maintained API or MCP server and set it up with [Custom Connectors and MCPs](/opt/muse/skills/custom-connector-setup/SKILL.md), or build a custom connector.

## Alternatives for better results

- Query a phext hosted by SQ on a ranch node when the worker needs repeated lookups across many scrolls, and fall back to a one-pass dispatch file for a fixed set of scrolls.

- Shrink the selection to a narrower prefix and dispatch again when a worker report shows it read past the material its task actually needed.
